{
  "name": "smart-grocery",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "api:dev": "tsx watch api/src/index.ts",
    "api:start": "tsx api/src/index.ts",
    "worker:start": "tsx worker/src/worker.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "flyers:download": "npm run flyers:download --workspace=scraper",
    "flyers:extract": "npm run flyers:extract --workspace=scraper --",
    "flyers:reextract": "npm run flyers:reextract --workspace=scraper --",
    "mimo:test": "npm run mimo:test --workspace=scraper --",
    "flyers:test-extraction": "npm run flyers:test-extraction --workspace=scraper --",
    "flows:run": "npm run flows:run --workspace=scraper --",
    "flows:record": "npm run flows:record --workspace=scraper --",
    "flows:codegen": "npm run flows:codegen --workspace=scraper --",
    "flows:session-worker": "npm run flows:session-worker --workspace=scraper",
    "flows:scheduler": "npm run flows:scheduler --workspace=scraper",
    "convex:dev": "npx convex dev",
    "convex:deploy": "npx convex deploy"
  },
  "workspaces": [
    "scraper"
  ],
  "devDependencies": {
    "convex": "^1.21.0",
    "tsx": "^4.20.6",
    "typescript": "^5.7.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@auth/core": "^0.41.1",
    "@convex-dev/auth": "^0.0.95",
    "fastify": "^5.3.3"
  }
}
