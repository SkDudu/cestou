generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN_MASTER
  CLIENT
}

enum FlyerStatus {
  DISCOVERED
  DOWNLOADING
  DOWNLOADED
  PROCESSING
  PARTIALLY_PROCESSED
  PROCESSED
  EXPIRED
  DUPLICATE
  FAILED
}

enum FlyerSourceType {
  PDF
  IMAGE
  WEB
  DYNAMIC
  MANUAL
}

enum FlyerSourceScope {
  SUPERMARKET
  STORE
}

enum OperationalStatus {
  ACTIVE
  INACTIVE
  ERROR
  NOT_CONFIGURED
}

enum OfferValidationStatus {
  PENDING
  VALIDATED
  REJECTED
  SUSPICIOUS
}

enum Eligibility {
  ALL_CUSTOMERS
  MEMBERS_ONLY
  UNKNOWN
}

enum EligibilityStatus {
  PENDING
  CONFIRMED
  REVIEW_REQUIRED
}

enum ExtractionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ScraperFlowStatus {
  DRAFT
  TESTING
  ACTIVE
  DISABLED
  ERROR
}

enum ScraperRunStatus {
  RUNNING
  SUCCESS
  PARTIAL
  CANCELLED
  DUPLICATE
  FAILED
}

enum NetworkType {
  SUPERMARKET
  WHOLESALE
  DISTRIBUTOR
}

enum FlyerErrorStage {
  DISCOVERY
  DOWNLOAD
  STORAGE
  OCR
  PARSER
  VALIDATION
  AI_VISION
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  passwordHash String
  role         UserRole
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]
  locations    Location[]
  favoriteStores FavoriteStore[]
  favoriteProducts FavoriteProduct[]
  shoppingLists ShoppingList[]
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Supermarket {
  id          String       @id @default(uuid()) @db.Uuid
  name        String
  slug        String       @unique
  city        String
  state       String
  country     String
  active      Boolean
  websiteUrl  String?
  timezone    String?
  networkType NetworkType?
  logoPath    String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  stores      Store[]
  flyerSources FlyerSource[]
  flyers      Flyer[]
  offers      Offer[]
  errors      FlyerError[]
  priceHistory PriceHistory[]
  scraperFlows ScraperFlow[]
}

model Store {
  id            String @id @default(uuid()) @db.Uuid
  supermarketId String @db.Uuid
  name          String
  slug          String
  address       String?
  number        String?
  neighborhood  String?
  city          String
  state         String
  zipCode       String?
  latitude      Float?
  longitude     Float?
  phone         String?
  url           String?
  externalId    String?
  active        Boolean
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  supermarket   Supermarket @relation(fields: [supermarketId], references: [id], onDelete: Cascade)
  sourceLinks   FlyerSourceStore[]
  flyerLinks    FlyerStore[]
  favoriteBy    FavoriteStore[]
  flows         ScraperFlow[]

  @@unique([supermarketId, slug])
  @@unique([supermarketId, externalId])
  @@index([supermarketId])
}

model FlyerSource {
  id                String @id @default(uuid()) @db.Uuid
  supermarketId     String @db.Uuid
  flowId            String? @db.Uuid
  name              String?
  type              FlyerSourceType
  url               String
  scope             FlyerSourceScope?
  operationalStatus OperationalStatus?
  active            Boolean
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  supermarket       Supermarket @relation(fields: [supermarketId], references: [id], onDelete: Cascade)
  flow              ScraperFlow? @relation(fields: [flowId], references: [id], onDelete: SetNull)
  storeLinks        FlyerSourceStore[]
  flyers            Flyer[]

  @@index([supermarketId, active])
  @@index([flowId])
}

model FlyerSourceStore {
  sourceId  String @db.Uuid
  storeId   String @db.Uuid
  createdAt DateTime @default(now())
  source    FlyerSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  store     Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([sourceId, storeId])
  @@index([storeId])
}

model Flyer {
  id           String @id @default(uuid()) @db.Uuid
  supermarketId String @db.Uuid
  sourceId     String @db.Uuid
  title        String?
  originalUrl  String
  externalId   String?
  filePath     String?
  fileType     String?
  fileSize     Int?
  fileHash     String?
  validFrom    DateTime?
  validUntil   DateTime?
  expiredAt    DateTime?
  status       FlyerStatus
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  supermarket  Supermarket @relation(fields: [supermarketId], references: [id], onDelete: Cascade)
  source       FlyerSource @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  pages        FlyerPage[]
  offers       Offer[]
  extractions  FlyerExtraction[]
  errors       FlyerError[]
  stores       FlyerStore[]

  @@index([supermarketId, fileHash])
  @@index([supermarketId, sourceId, validFrom, validUntil])
  @@index([supermarketId, externalId])
  @@index([status, validUntil])
  @@index([sourceId])
}

model FlyerStore {
  flyerId String @db.Uuid
  storeId String @db.Uuid
  flyer Flyer @relation(fields: [flyerId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  @@id([flyerId, storeId])
}

model FlyerPage {
  id         String @id @default(uuid()) @db.Uuid
  flyerId    String @db.Uuid
  pageNumber Int
  filePath   String
  mimeType   String?
  fileSize   Int?
  fileHash   String?
  createdAt  DateTime @default(now())
  flyer      Flyer @relation(fields: [flyerId], references: [id], onDelete: Cascade)
  extractions FlyerExtraction[]

  @@unique([flyerId, pageNumber])
}

model Offer {
  id                 String @id @default(uuid()) @db.Uuid
  flyerId            String @db.Uuid
  supermarketId      String @db.Uuid
  name               String
  brand              String?
  quantity           String?
  unit               String?
  price              Decimal @db.Decimal(12, 2)
  originalPrice      Decimal? @db.Decimal(12, 2)
  cashPrice          Decimal? @db.Decimal(12, 2)
  installmentCount   Int?
  installmentAmount  Decimal? @db.Decimal(12, 2)
  installmentInterestFree Boolean?
  discountPercentage Decimal? @db.Decimal(5, 2)
  pageNumber         Int?
  rawText            String?
  extractionConfidence Float?
  eligibility        Eligibility?
  conditions         Json?
  eligibilityConfidence Float?
  eligibilityEvidence Json?
  eligibilityStatus  EligibilityStatus?
  normalizedName     String?
  normalizedBrand    String?
  quantityValue      Float?
  unitNormalized     String?
  brandId            String? @db.Uuid
  canonicalProductId String? @db.Uuid
  publicPrice        Decimal? @db.Decimal(12, 2)
  memberPrice        Decimal? @db.Decimal(12, 2)
  requiresMembership Boolean?
  membershipName     String?
  sourceType         String @default("flyer")
  sourceFlyerTitle   String?
  sourceFlyerUrl     String?
  sourceFlyerHash    String?
  sourceEvidencePurgedAt DateTime?
  validationStatus   OfferValidationStatus
  validFrom          DateTime?
  validUntil         DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  flyer              Flyer @relation(fields: [flyerId], references: [id], onDelete: Cascade)
  supermarket        Supermarket @relation(fields: [supermarketId], references: [id], onDelete: Cascade)
  brandRecord        Brand? @relation(fields: [brandId], references: [id], onDelete: SetNull)
  canonicalProduct   CanonicalProduct? @relation(fields: [canonicalProductId], references: [id], onDelete: SetNull)
  eligibilityHistory OfferEligibilityHistory[]
  priceHistory       PriceHistory[]
  listItems          ShoppingListItem[]

  @@index([validationStatus])
  @@index([supermarketId, validationStatus])
  @@index([canonicalProductId, validUntil])
  @@index([brandId])
  @@index([normalizedName])
}

model OfferEligibilityHistory {
  id                 String @id @default(uuid()) @db.Uuid
  offerId            String @db.Uuid
  previousEligibility Eligibility?
  newEligibility     Eligibility
  previousConfidence Float?
  newConfidence      Float?
  source             String
  reason             String?
  createdAt          DateTime @default(now())
  offer              Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  @@index([offerId, createdAt])
}

model FlyerExtraction {
  id                   String @id @default(uuid()) @db.Uuid
  flyerId              String @db.Uuid
  pageId               String @db.Uuid
  pageNumber           Int
  provider             String
  model                String
  promptVersion        String
  status               ExtractionStatus
  rawResponse          String?
  offerCount           Int?
  extractionConfidence Float?
  error                String?
  inputTokens          Int?
  outputTokens         Int?
  totalTokens          Int?
  durationMs           Int?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  flyer                Flyer @relation(fields: [flyerId], references: [id], onDelete: Cascade)
  page                 FlyerPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  @@index([flyerId, pageNumber])
  @@index([pageId, model, promptVersion])
}

model FlyerError {
  id            String @id @default(uuid()) @db.Uuid
  flyerId       String? @db.Uuid
  supermarketId String @db.Uuid
  stage         FlyerErrorStage
  message       String
  stack         String?
  status        String @default("open")
  createdAt     DateTime @default(now())
  flyer         Flyer? @relation(fields: [flyerId], references: [id], onDelete: SetNull)
  supermarket   Supermarket @relation(fields: [supermarketId], references: [id], onDelete: Cascade)
  @@index([supermarketId, status, createdAt])
  @@index([flyerId])
}

model ScraperFlow {
  id                String @id @default(uuid()) @db.Uuid
  supermarketId     String @db.Uuid
  storeId           String? @db.Uuid
  scope             FlyerSourceScope?
  name              String
  startUrl          String
  status            ScraperFlowStatus
  version           Int
  config            Json?
  schedule          String?
  nextRunAt         DateTime?
  lastRunAt         DateTime?
  discoveryAttempts Int? @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  supermarket       Supermarket @relation(fields: [supermarketId], references: [id], onDelete: Cascade)
  store             Store? @relation(fields: [storeId], references: [id], onDelete: SetNull)
  sources           FlyerSource[]
  steps             ScraperStep[]
  runs              ScraperRun[]
  setupEvents       ScraperSetupEvent[]
  @@index([supermarketId, status])
  @@index([storeId])
}

model ScraperStep {
  id        String @id @default(uuid()) @db.Uuid
  flowId    String @db.Uuid
  order     Int
  type      String
  config    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  flow      ScraperFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)
  @@unique([flowId, order])
}

model ScraperRun {
  id          String @id @default(uuid()) @db.Uuid
  flowId      String @db.Uuid
  status      ScraperRunStatus
  startedAt   DateTime @default(now())
  finishedAt  DateTime?
  error       String?
  stepsExecuted Int @default(0)
  flyersFound Int @default(0)
  storesFound Int @default(0)
  log         String?
  flow        ScraperFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)
  events      ScraperRunEvent[]
  @@index([flowId, startedAt])
}

model ScraperRunEvent {
  id        String @id @default(uuid()) @db.Uuid
  runId     String @db.Uuid
  sequence  Int
  type      String
  payload   Json
  createdAt DateTime @default(now())
  run       ScraperRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  @@unique([runId, sequence])
}

model ScraperSetupEvent {
  id        String @id @default(uuid()) @db.Uuid
  flowId    String @db.Uuid
  sessionId String?
  order     Int
  at        DateTime
  kind      String
  label     String
  payload   Json?
  flow      ScraperFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)
  @@unique([flowId, order])
}

model Brand {
  id        String @id @default(uuid()) @db.Uuid
  name      String
  slug      String @unique
  aliases   String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  products  CanonicalProduct[]
  offers    Offer[]
}

model CanonicalProduct {
  id        String @id @default(uuid()) @db.Uuid
  canonicalName String
  slug      String @unique
  brandId   String? @db.Uuid
  quantity  String?
  unit      String?
  category  String?
  matchKey  String @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  brand     Brand? @relation(fields: [brandId], references: [id], onDelete: SetNull)
  offers    Offer[]
  priceHistory PriceHistory[]
  favoriteBy FavoriteProduct[]
  listItems ShoppingListItem[]
  @@index([brandId])
}

model PriceHistory {
  id                 String @id @default(uuid()) @db.Uuid
  canonicalProductId String @db.Uuid
  supermarketId      String @db.Uuid
  offerId            String @db.Uuid
  price              Decimal @db.Decimal(12, 2)
  originalPrice      Decimal? @db.Decimal(12, 2)
  memberPrice        Decimal? @db.Decimal(12, 2)
  requiresMembership Boolean?
  membershipName     String?
  validFrom          DateTime?
  validUntil         DateTime?
  createdAt          DateTime @default(now())
  canonicalProduct   CanonicalProduct @relation(fields: [canonicalProductId], references: [id], onDelete: Cascade)
  supermarket        Supermarket @relation(fields: [supermarketId], references: [id], onDelete: Cascade)
  offer              Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  @@index([canonicalProductId, supermarketId, createdAt])
  @@index([offerId])
}

model Location {
  id          String @id @default(uuid()) @db.Uuid
  userId      String @db.Uuid
  label       String
  city        String
  state       String
  neighborhood String?
  addressText String?
  lat         Float?
  lng         Float?
  isDefault   Boolean
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
  shoppingLists ShoppingList[]
  @@index([userId, isDefault])
}

model FavoriteStore {
  userId String @db.Uuid
  storeId String @db.Uuid
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  @@id([userId, storeId])
}

model FavoriteProduct {
  userId String @db.Uuid
  canonicalProductId String @db.Uuid
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  canonicalProduct CanonicalProduct @relation(fields: [canonicalProductId], references: [id], onDelete: Cascade)
  @@id([userId, canonicalProductId])
}

model ShoppingList {
  id        String @id @default(uuid()) @db.Uuid
  userId    String @db.Uuid
  name      String
  locationId String? @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  location  Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  items     ShoppingListItem[]
  @@index([userId])
}

model ShoppingListItem {
  id                 String @id @default(uuid()) @db.Uuid
  listId             String @db.Uuid
  queryText          String
  offerId            String? @db.Uuid
  canonicalProductId String? @db.Uuid
  quantity           Int
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  list               ShoppingList @relation(fields: [listId], references: [id], onDelete: Cascade)
  offer              Offer? @relation(fields: [offerId], references: [id], onDelete: SetNull)
  canonicalProduct   CanonicalProduct? @relation(fields: [canonicalProductId], references: [id], onDelete: SetNull)
  @@index([listId])
}
