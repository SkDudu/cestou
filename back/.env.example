# Fastify + PostgreSQL local backend
API_PORT=4000
CORS_ORIGIN=http://localhost:3000
# Host-side Prisma/API: 127.0.0.1. Docker Compose overrides this to hostname postgres.
DATABASE_URL=postgresql://smart_grocery:smart_grocery@127.0.0.1:5432/smart_grocery?schema=public
STORAGE_ROOT=/data/storage
ADMIN_MASTER_EMAIL=admin@example.test
ADMIN_SEED_PASSWORD=change-me-in-your-local-env

# Convex (removed in final migration task)

# Flyer download / extract
FLYER_DOWNLOAD_TIMEOUT=30000
FLYER_DOWNLOAD_RETRIES=3
FLYER_MAX_SIZE_MB=50
FLYER_DISCOVERY_BEFORE_EXPIRATION_HOURS=24
FLYER_SCHEDULER_POLL_MS=3600000
FLYER_BATCH_SIZE=10
FLYER_CONCURRENCY=2
FLYER_ALLOWED_HOSTS=mercadapp.com.br,merconnect.mercadapp.com.br,cdn.mercadapp.services,mercadinhossaoluiz.com.br,atacadao.com.br,vtexassets.com,carrefour.com.br,apigw.cloud.carrefour.com.br,assai.com.br,www.assai.com.br,cloudfront.net,grupocenterbox.com.br,adminx.cometasupermercados.com.br,regexsolutions.com.br

# MiMo-V2.5 Vision (SPEC 012)
# Pay-as-you-go (default): sk-… + https://api.xiaomimimo.com/v1
# Token Plan (alt): tp-… + https://token-plan-cn.xiaomimimo.com/v1
# Auth: Authorization Bearer (see client.ts). Docs: mimo.mi.com/docs
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5
MIMO_MAX_COMPLETION_TOKENS=8192
MIMO_TIMEOUT=300000
MIMO_MAX_RETRIES=3
MIMO_CONCURRENCY=2

FLYER_AI_ENABLED=true
FLYER_AI_PROVIDER=mimo
FLYER_AI_PROMPT_VERSION=flyer-offers-v5
# Resize target edge (px). Runtime resize currently Darwin-only (sips).
FLYER_AI_MAX_IMAGE_EDGE_PX=2048

# Flow defaults
SAO_LUIZ_BASE_URL=https://mercadinhossaoluiz.com.br
DISCOVERY_CITY=Fortaleza
DISCOVERY_STATE=CE

BROWSER_HEADLESS=true
BROWSER_TIMEOUT=30000
BROWSER_NAVIGATION_TIMEOUT=30000
SCRAPER_MAX_RETRIES=3

# Dashboard browser session worker
BROWSER_SESSION_HOST=127.0.0.1
BROWSER_SESSION_PORT=8791
BROWSER_SESSION_FPS=2
BROWSER_SESSION_JPEG_QUALITY=60
BROWSER_SESSION_TTL_MS=600000
BROWSER_SESSION_MAX_MS=1800000
BROWSER_SESSION_CORS_ORIGIN=http://localhost:3000
# false = headed (modals/selects show in teach preview). true = no OS window.
BROWSER_SESSION_HEADLESS=false

LOG_LEVEL=info
