{
  "name": "scraper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node --env-file=../.env dist/index.js",
    "dev": "tsc && node --env-file=../.env dist/index.js",
    "scrape": "tsc && node --env-file=../.env dist/index.js",
    "scrape:sao-luiz": "SCRAPER_SUPERMARKET=sao-luiz npm run scrape",
    "scrape:pao-de-acucar": "SCRAPER_SUPERMARKET=pao-de-acucar npm run scrape",
    "validate": "tsc && node --env-file=../.env dist/validate.js",
    "enrich:brands": "tsc && node --env-file=../.env dist/enrich-brands.js",
    "selfcheck": "tsc && node dist/selfcheck.js"
  },
  "dependencies": {
    "convex": "^1.21.0",
    "playwright": "^1.50.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
