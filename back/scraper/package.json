{
  "name": "scraper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "flyers:discover": "tsc && node --env-file=../.env dist/flyers/jobs/flyer-discovery.js",
    "flyers:download": "tsc && node --env-file=../.env dist/flyers/jobs/flyer-download.js",
    "flyers:extract": "tsc && node --env-file=../.env dist/flyers/jobs/flyer-extraction.js",
    "flyers:reextract": "tsc && node --env-file=../.env dist/flyers/jobs/flyer-extraction.js --force",
    "flyers:expire": "tsc && node --env-file=../.env dist/flyers/jobs/flyer-expiration.js",
    "flyers:sync": "tsc && node --env-file=../.env dist/flyers/jobs/flyer-sync.js",
    "selfcheck": "tsc && node dist/flyers/selfcheck.js"
  },
  "dependencies": {
    "convex": "^1.21.0",
    "playwright": "^1.50.0",
    "tesseract.js": "^6.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
