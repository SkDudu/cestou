{
  "name": "scraper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "flyers:download": "tsc && node --env-file=../.env dist/flyers/jobs/flyer-download.js",
    "flyers:extract": "tsc && node --env-file=../.env dist/flyers/jobs/flyer-extraction.js",
    "flyers:reextract": "tsc && node --env-file=../.env dist/flyers/jobs/flyer-extraction.js --force",
    "mimo:test": "tsc && node --env-file=../.env dist/flyers/jobs/mimo-test.js",
    "flyers:test-extraction": "tsc && node --env-file=../.env dist/flyers/jobs/flyer-test-extraction.js",
    "flows:run": "tsc && node --env-file=../.env dist/flyers/jobs/flow-run.js",
    "flows:record": "tsc && node --env-file=../.env dist/flyers/jobs/flow-record.js",
    "flows:codegen": "playwright codegen --viewport-size=1280,720",
    "flows:session-worker": "tsc && node --env-file=../.env dist/flyers/jobs/flow-session-worker.js",
    "flows:scheduler": "tsc && node --env-file=../.env dist/flyers/jobs/flow-scheduler.js",
    "selfcheck": "tsc && node dist/flyers/selfcheck.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "pg": "^8.16.3",
    "playwright": "^1.50.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
